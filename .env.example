# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key (get one at https://aistudio.google.com/apikey).
# Accepts both current "AQ." auth keys and legacy "AIza" standard keys.
GOOGLE_API_KEY=

# Gemini model id used for chat/bill-analysis calls.
GEMINI_MODEL=gemini-2.0-flash

# Flask session-signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production — the app falls back to an insecure dev default if unset.
SECRET_KEY=

# Email delivery through Brevo HTTP API. Do not use Gmail SMTP on free hosts.
EMAIL_REPLY_TO=
CONTACT_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AyushScan

# SQLite database path. In production, set this to a persistent disk path.
DATABASE_PATH=/data/users.db

# Optional: only needed if Tesseract isn't on PATH or you want a non-English OCR language.
TESSERACT_CMD=
TESSERACT_LANG=eng

# Optional: PDF OCR tuning (defaults shown).
PDF_OCR_MAX_PAGES=12
PDF_OCR_SCALE=3.5
