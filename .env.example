# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key (get one at https://aistudio.google.com/apikey).
# Accepts both current "AQ." auth keys and legacy "AIza" standard keys.
GOOGLE_API_KEY=

# Gemini model id used for chat/bill-analysis calls.
GEMINI_MODEL=gemini-2.0-flash

# Flask session-signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production — the app falls back to an insecure dev default if unset.
SECRET_KEY=

# SMTP credentials used to send OTP / contact-form emails via Gmail SMTP.
# EMAIL_PASSWORD should be a Gmail App Password, not your account password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional: only needed if Tesseract isn't on PATH or you want a non-English OCR language.
TESSERACT_CMD=
TESSERACT_LANG=eng

# Optional: PDF OCR tuning (defaults shown).
PDF_OCR_MAX_PAGES=12
PDF_OCR_SCALE=3.5
